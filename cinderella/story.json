    },
    {
      "id": "03",
      "segment": 2,
      "beat": "fairy-godmother",
      "narration": "One evening, music drifted from the palace, where everyone had been invited to a ball. Cinderella wished she could go. Just then, her fairy godmother appeared with a gentle smile.",
      "pixelpop_image": "pixelpop/03.jpg",
      "normal_image": "normal/03.jpg",
      "audio_clip": "narration/pages/03.wav",
