    },
    {
      "id": "05",
      "segment": 3,
      "beat": "ballroom-arrival",
      "narration": "Cinderella arrived in a silver-blue gown and sparkling glass slippers. The palace windows shone like stars.",
      "pixelpop_image": "pixelpop/05.jpg",
      "normal_image": "normal/05.jpg",
      "audio_clip": "narration/pages/05.wav",
      "cue": {
