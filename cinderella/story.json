    },
    {
      "id": "04",
      "segment": 2,
      "beat": "pumpkin-carriage",
      "narration": "A twinkle of her wand turned an ordinary pumpkin into a golden carriage. Remember, she said, this lovely magic lasts only until midnight.",
      "pixelpop_image": "pixelpop/04.jpg",
      "normal_image": "normal/04.jpg",
      "audio_clip": "narration/pages/04.wav",
