      }
    },
    {
      "id": "02",
      "segment": 1,
      "beat": "helpful-birds",
      "narration": "Though her chores were many, she always left a little room in her day for kindness. The birds answered her quiet songs with songs of their own.",
      "pixelpop_image": "pixelpop/02.jpg",
      "normal_image": "normal/02.jpg",
      "audio_clip": "narration/pages/02.wav",
