      }
    },
    {
      "id": "09",
      "segment": 5,
      "beat": "glass-slipper",
      "narration": "The prince found the glass slipper resting on a step. He hoped to find the kind person who had shared his dance.",
      "pixelpop_image": "pixelpop/09.jpg",
      "normal_image": "normal/09.jpg",
      "audio_clip": "narration/pages/09.wav",
