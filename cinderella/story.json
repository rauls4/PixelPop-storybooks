      "id": "01",
      "segment": 1,
      "beat": "hearth",
      "narration": "Once upon a time, a kind young woman named Cinderella lived in a house with a warm kitchen hearth. Each morning she swept the floor and cared for the garden birds.",
      "pixelpop_image": "pixelpop/01.jpg",
      "normal_image": "normal/01.jpg",
      "audio_clip": "narration/pages/01.wav",
      "cue": {
        "kind": "segment_start",
