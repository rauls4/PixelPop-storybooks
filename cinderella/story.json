    },
    {
      "id": "08",
      "segment": 4,
      "beat": "palace-steps",
      "narration": "Cinderella thanked the prince and hurried down the palace steps. One glass slipper slipped from her foot, but she had no time to stop. She reached home as the carriage became a pumpkin again. Her gown was simple once more, yet the memory of the evening still glowed in her heart.",
      "pixelpop_image": "pixelpop/08.jpg",
      "normal_image": "normal/08.jpg",
      "audio_clip": "narration/pages/08.wav",
      "cue": {
