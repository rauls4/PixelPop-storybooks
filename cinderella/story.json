      }
    },
    {
      "id": "06",
      "segment": 3,
      "beat": "dance",
      "narration": "A young prince welcomed her, and together they danced beneath the golden lights. They talked about gardens, books, and all the small things that made them happy. For a little while, Cinderella felt as light as a song.",
      "pixelpop_image": "pixelpop/revised/06.jpg",
      "normal_image": "normal/06.jpg",
      "audio_clip": "narration/pages/06.wav",
